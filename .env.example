# ── Required: JWT Authentication ─────────────────────────────────────────────
# App Store Connect → Users and Access → Integrations → Team Keys
APPSTORE_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
APPSTORE_KEY_ID=XXXXXXXXXX

# ── Private Key — choose ONE of the two options below ────────────────────────
# Option A: File path (local / Claude Desktop)
APPSTORE_PRIVATE_KEY_PATH=./keys/AuthKey_XXXXXXXXXX.p8

# Option B: Key content as string (cloud / Railway — use this instead of PATH)
# Paste the full .p8 file content, including BEGIN/END lines.
# APPSTORE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIGH...\n-----END PRIVATE KEY-----

# ── Required: Sales & Finance Reports ────────────────────────────────────────
# App Store Connect → Sales and Trends → Reports → Vendor Number
APPSTORE_VENDOR_NUMBER=12345678

# ── Optional: Default App Selection ──────────────────────────────────────────
# Numeric App Store ID (e.g. 6502225088) or bundle ID (e.g. com.example.app).
# If not set, call select_app() before using any app-specific tool.
APPSTORE_APP_ID=com.example.app

# Bundle ID — only needed when APPSTORE_APP_ID is a bundle ID string.
# Can be omitted if APPSTORE_APP_ID is already the bundle ID.
APPSTORE_BUNDLE_ID=com.example.app

# ── Transport ─────────────────────────────────────────────────────────────────
# "stdio" for local / Claude Desktop (default)
# "http"  for cloud / Railway — set automatically via railway.toml
# MCP_TRANSPORT=stdio
